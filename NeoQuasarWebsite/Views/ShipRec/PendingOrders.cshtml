@using System.Text.Json
@using NeoQuasarWebsite.Data
@model PendingOrdersViewModel

@{
    ViewData["Title"] = "Pending Orders";
}
@{
    var lines = 0;
}

<div class="container-fluid bg-dark text-light" x-data="pendingorders({ orderID: '@Model.OrderID' })" x-init="init()" >
    <div class="row">
        @* Selected Order *@
        <div class="col-9">
            <br />
            <table class="table-dark">
                <tr>
                    <th class="text-start col-2">
                        PO#
                    </th>
                    <td class="col-3">
                        <fieldset>
                            <input class="form-control" id="id" type="text" x-model="order.id" disabled="">
                        </fieldset>
                    </td>
                    <div class="col-1"></div>
                    <th class="text-end col-2 pe-2">
                        Date
                    </th>
                    <td class="col-3">
                        <fieldset>
                            <input class="form-control" id="date" x-model="order.date" disabled="">
                        </fieldset>
                    </td>
                    <td class="col-1">
                        <a class="btn btn-secondary w-auto" :href="`/shiprec/receipthistory?orderID=${order.id}`">RECEIPTS</a>
                    </td>
                </tr>
                <tr>
                    <template x-if="outgoing">
                    <th class="text-start">
                        Recipient
                    </th>
                    </template>
                    <template x-if="outgoing">
                    <td>
                        <fieldset>
                            <input class="form-control" id="recipient" x-model="order.recipient" disabled="">
                        </fieldset>
                    </td>
                    </template>
                    <template x-if="!outgoing">
                    <th class="text-start">
                        Shipper
                    </th>
                    </template>
                    <template x-if="!outgoing">
                    <td>
                        <fieldset>
                            <input class="form-control" id="shipper" x-model="order.shipper" disabled="">
                        </fieldset>
                    </td>
                    </template>
                    <th class="text-end pe-2">
                        Contact Address
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" id="contact" x-model="order.contactAddress" disabled="">
                        </fieldset>
                    </td>
                    <td>
                        <button class="btn btn-secondary" x-on:click="submit()">SUBMIT</button>
                    </td>
                </tr>
                <template x-if="outgoing">
                <tr x-show="outgoing">
                    <th class="text-start">
                        Address
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" id="address" x-model="order.shippingAddress" disabled="">
                        </fieldset>
                    </td>
                    <th class="text-end pe-2">
                        LOC Code
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" id="loccode" x-model="order.locatorCode" disabled="" />
                        </fieldset>
                    </td>
                </tr>
                </template>
                <tr>
                    <th class="text-start">
                        Courier
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" id="courier" x-model="order.courier"/>
                        </fieldset>
                    </td>
                    <th class="text-end pe-2">
                        Tracking Number
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" x-model="order.trackingNumber" />
                        </fieldset>
                    </td>
                </tr>
            </table>
            <br />
            <table class="table-dark">
                <tr>
                    <th class="col-1 style="text-align:center;">Shipped</th>
                    <th class="col-1" style="text-align:center;">Outstanding</th>
                    <th class="col-1" style="text-align:center;">Ordered</th>
                    <th class="col-2" style="text-align:center;">NEO SKU</th>
                    <th class="col-7">DESCRIPTION</th>
                </tr>
                <template x-for="line in order.lines">
                    <tr>
                        <td><input class="form-control col-1" min="0" type="number" x-model="line.received"/></td>
                        <td><input class="form-control col-1" x-model="line.outstanding" disabled=""></td>
                        <td><input class="form-control col-1" x-model="line.ordered" disabled=""></td>
                        <td><input class="form-control col-2" x-model="line.neoSKU" disabled=""></td>
                        <td><input class="form-control col-7" x-model="line.description" disabled=""></td>
                    
                    </tr>
                </template>
                @for (int i = lines; i < 6; i++){
                    <tr>
                        <td><input class="form-control"  type="text" id="rec" name="rec" readonly=""/></td>
                        <td><input class="form-control" id="bo" type="text" value=""  disabled=""></td>
                        <td><input class="form-control" id="ord" type="text" value="" disabled=""></td>
                        <td><input class="form-control" id="neo" type="text" value=""  disabled=""></td>
                        <td><input class="form-control" id="name" type="text" value=""  disabled=""></td>
                    </tr>
                }
            </table>
        </div>
        @* Order List *@
        <div class="col-3">
            <br />
            <div class="h2" style="color:#a6e6ff; text-align:center;">PENDING ORDERS</div><br />
            <div class="row">
                <div class="btn-group" role="group" aria-label="incoming-outgoing">
                    <input type="radio" class="btn-check col-6 btn-direction" name="direction" id="incoming" autocomplete="off" checked="" data-dir="incoming">
                    <label class="btn btn-outline-info" for="incoming">Incoming (@Model.GetIncomingOrders().Count())</label>
                    <input type="radio" class="btn-check col-6 btn-direction" name="direction" id="outgoing" autocomplete="off" checked="" data-dir="outgoing">
                    <label class="btn btn-outline-info" for="outgoing">Outgoing (@Model.GetOutgoingOrders().Count())</label>
                </div>
            </div>
            <br />
            <div class="row list-outgoing">
                @foreach(OrderModel o in Model.GetOutgoingOrders()){
                    var label = $"{o.ID} - {o.Recipient}";
                    var id = JsonSerializer.Serialize(new {orderID = o.ID});
                @if (o.ShippingOption == "Emergency"){
                    <a class="btn btn-danger ps-2 pe-2" x-on:click="selectOrder(@id)">@label</a>
                }
                else if (o.ShippingOption == "Expedited"){
                    <a class="btn btn-warning ps-2 pe-2" x-on:click="selectOrder(@id)">@label</a>
                }
                else {
                    <a class="btn btn-secondary ps-2 pe-2" x-on:click="selectOrder(@id)">@label</a>
                }
                <hr class="hr-slash"/>
                }
            </div>
            <div class="row list-incoming" style="display:none">
                @foreach(OrderModel o in Model.GetIncomingOrders()){
                    var label = $"{o.ID} - {o.Shipper}";
                    var id = JsonSerializer.Serialize(new {orderID = o.ID});
                    <a class="btn btn-primary ps-2 pe-2" x-on:click="selectOrder(@id)">@label</a>
                <hr class="hr-slash"/>
                }
            </div>
        </div>
    </div>
    <br />
</div> 