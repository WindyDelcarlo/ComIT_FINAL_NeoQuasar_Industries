@using NeoQuasarWebsite.Data
@model PendingOrdersModel

@{
    ViewData["Title"] = "Pending Orders";
}
@{
    var lines = 0;
    var selectedOrder = new Order(Order.GetDatabase().FirstOrDefault(o => o.OrderID == Model.OrderID));
}

<div class="container-fluid bg-dark text-light">
    <div class="row">
        @* Selected Order *@
        <div class="col-9">
            <form asp-action="PendingOrders" method="post">
            <input class="form-control" asp-for="OrderID" hidden />
            <br />
            <table class="table-dark">
                <tr>
                    <th class="text-start col-2">
                        PO#
                    </th>
                    <td class="col-3">
                        <fieldset>
                            <input class="form-control" id="poNumber" type="text" value="@selectedOrder.ID" disabled="">
                        </fieldset>
                    </td>
                    <div class="col-1"></div>
                    <th class="text-end col-2 pe-2">
                        Date
                    </th>
                    <td class="col-3">
                        <fieldset>
                            <input class="form-control" id="date" type="text" value="@selectedOrder.Date" disabled="">
                        </fieldset>
                    </td>
                    <td class="col-1">
                        <button class="btn btn-secondary w-auto">NEW</button>
                    </td>
                </tr>
                <tr>
                 @if(selectedOrder.ShippingDirection == Order.Direction.OUTGOING){
                    <th class="text-start">
                        Recipient
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" id="recipient" type="text" value="@selectedOrder.Recipient" disabled="">
                        </fieldset>
                    </td>
                    }
                    else {
                    <th class="text-start">
                        Shipper
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" id="recipient" type="text" value="@selectedOrder.Shipper" disabled="">
                        </fieldset>
                    </td>
                    }
                    <th class="text-end pe-2">
                        Contact Address
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" id="contactAddress" type="text" value="@selectedOrder.ContactAddress" disabled="">
                        </fieldset>
                    </td>
                    <td>
                        <button class="btn btn-secondary">SUBMIT</button>
                    </td>
                </tr>
                <tr>
                @if(selectedOrder.ShippingDirection == Order.Direction.OUTGOING){
                    <th class="text-start">
                        Address
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" id="address" type="text" value="@selectedOrder.ShippingAddress" disabled="">
                        </fieldset>
                    </td>
                    <th class="text-end pe-2">
                        LOC Code
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" id="locCode" type="text" value="@selectedOrder.LocationCode" disabled="" />
                        </fieldset>
                    </td>
                }
                </tr>
                <tr>
                    <th class="text-start">
                        Courier
                    </th>
                    <td>
                        <fieldset>
                            <input asp-for="Courier" class="form-control "/>
                        </fieldset>
                    </td>
                    <th class="text-end pe-2">
                        Tracking Number
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" asp-for="TrackingNumber" />
                        </fieldset>
                    </td>
                </tr>
            </table>
            <br />
            <table class="table-dark">
                <tr>
                    <th class="col-1 style="text-align:center;">Rec'd</th>
                    <th class="col-1" style="text-align:center;">Outstanding</th>
                    <th class="col-1" style="text-align:center;">Ordered</th>
                    <th class="col-2" style="text-align:center;">NEO SKU</th>
                    <th class="col-7">DESCRIPTION</th>
                </tr>
                @for(int i = 0; i < LineItem.OrderLineDatabase().Where(old => old.OrderID == selectedOrder.ID).Count(); i++){
                    var old = LineItem.OrderLineDatabase().Where(old => old.OrderID == selectedOrder.ID).ToList()[i];
                    var item = StockItem.Get(old.ItemSKU);
                    <tr>
                        @{string receivedId = "received" + @lines;}
                        @{string boId = "backorder" + @lines;}
                        @{string orderedId = "ordered" + @lines;}
                        @{string neoSkuId = "neosku" + @lines;}
                        @{string nameId = "name" + @lines;}
                        @{int backOrdered = old.AmountOrdered - old.Shipped;}
                        <td><input class="form-control col-1"  asp-for="Received[i]"/></td>
                        <td><input class="form-control col-1" id="@boId" type="text" value="@backOrdered"  disabled=""></td>
                        <td><input class="form-control col-1" id="@orderedId" type="text" value="@old.AmountOrdered" disabled=""></td>
                        <td><input class="form-control col-2" id="@neoSkuId" type="text" value="@item.NeoSKU" disabled=""></td>
                        <td><input class="form-control col-7" id="@nameId" type="text" value="@item.Name" disabled=""></td>
                    </tr>
                }
                @for (int i = lines; i < 6; i++){
                    <tr>
                        <td><input class="form-control"  type="text" id="rec" name="rec" readonly=""/></td>
                        <td><input class="form-control" id="bo" type="text" value=""  disabled=""></td>
                        <td><input class="form-control" id="ord" type="text" value="" disabled=""></td>
                        <td><input class="form-control" id="neo" type="text" value=""  disabled=""></td>
                        <td><input class="form-control" id="name" type="text" value=""  disabled=""></td>
                    </tr>
                }
            </table> 
            </form>
        </div>
        @* Order List *@
        <div class="col-3">
            <br />
            <div class="h2" style="color:#a6e6ff; text-align:center;">PENDING ORDERS</div><br />
            <div class="row">
                <div class="btn-group" role="group" aria-label="incoming-outgoing">
                    <input type="radio" class="btn-check col-6 btn-direction" name="direction" id="incoming" autocomplete="off" checked="" data-dir="incoming">
                    <label class="btn btn-outline-info" for="incoming">Incoming (@Model.GetIncomingOrders().Count())</label>
                    <input type="radio" class="btn-check col-6 btn-direction" name="direction" id="outgoing" autocomplete="off" checked="" data-dir="outgoing">
                    <label class="btn btn-outline-info" for="outgoing">Outgoing (@Model.GetOutgoingOrders().Count())</label>
                </div>
            </div>
            <br />
            <div class="row list-outgoing">
                @foreach(Order o in Model.GetOutgoingOrders()){
                    var label = $"{o.ID} - {o.Recipient}";
                @if (o.ShippingOption == "Emergency"){
                    <a class="btn btn-danger ps-2 pe-2" href="/shiprec/selectorder/@o.ID">@label</a>
                }
                else if (o.ShippingOption == "Expedited"){
                    <a class="btn btn-warning ps-2 pe-2" href="/shiprec/selectorder/@o.ID">@label</a>
                }
                else {
                    <a class="btn btn-secondary ps-2 pe-2" href="/shiprec/selectorder/@o.ID">@label</a>
                }
                <hr class="hr-slash"/>
                }
            </div>
            <div class="row list-incoming" style="display:none">
                @foreach(Order o in Model.GetIncomingOrders()){
                    var label = $"{o.ID} - {o.Shipper}";
                    <a class="btn btn-primary ps-2 pe-2" href="/shiprec/selectorder/@o.ID">@label</a>
                <hr class="hr-slash"/>
                }
            </div>
        </div>
    </div>
    <br />
</div> 