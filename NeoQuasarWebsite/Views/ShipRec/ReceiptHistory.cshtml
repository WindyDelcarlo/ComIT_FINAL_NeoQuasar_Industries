@using NeoQuasarWebsite.DTO
@using NeoQuasarWebsite.Data
@model ReceiptHistoryModel


@{
    ViewData["Title"] = "Receipt List";
    int lines = 0;
}

<div class="container-fluid bg-dark text-light">
    <div class="row">
        @* Selected Order *@
        <div class="col-9">
            <input class="form-control" hidden />
            <br />
            <table class="table-dark">
                <tr>
                    <th class="text-start col-2">
                        PO#
                    </th>
                    <td class="col-3">
                        <fieldset>
                            <input class="form-control" id="poNumber" type="text" value="@Model.Receipt.OrderID" disabled="">
                        </fieldset>
                    </td>
                    <div class="col-1"></div>
                    <th class="text-end col-2 pe-2">
                        Date
                    </th>
                    <td class="col-3">
                        <fieldset>
                            <input class="form-control" id="date" type="text" value="@Model.Receipt.Date" disabled="">
                        </fieldset>
                    </td>
                    <td class="col-1">
                    </td>
                </tr>
                <tr>
                 @if(Model.Receipt.OrderID.StartsWith("PO")){
                    <th class="text-start">
                        Recipient
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" id="recipient" type="text" value="@Model.Receipt.Recipient" disabled="">
                        </fieldset>
                    </td>
                    }
                    else {
                    <th class="text-start">
                        Shipper
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" id="recipient" type="text" value="@Model.Receipt.Shipper" disabled="">
                        </fieldset>
                    </td>
                    }
                    <th class="text-end pe-2">
                        Contact Address
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" id="contactAddress" type="text" value="@Model.Receipt.ContactAddress" disabled="">
                        </fieldset>
                    </td>
                    <td>
                        <button class="btn btn-secondary btn-delete-receipt" data-id=@Model.Receipt.ReceiptID>DELETE</button>
                    </td>
                </tr>
                <tr>
                    <th class="text-start">
                        Courier
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" disabled="" value="@Model.Receipt.Courier"/>
                        </fieldset>
                    </td>
                    <th class="text-end pe-2">
                        Tracking Number
                    </th>
                    <td>
                        <fieldset>
                            <input class="form-control" value="@Model.Receipt.TrackingNumber" disabled=""/>
                        </fieldset>
                    </td>
                </tr>
            </table>
            <br />
            <table class="table-dark">
                <tr>
                    <th class="col-1 style="text-align:center;">Shipped</th>
                    <th class="col-1" style="text-align:center;">Ordered</th>
                    <th class="col-2" style="text-align:center;">NEO SKU</th>
                    <th class="col-7">DESCRIPTION</th>
                </tr>
                @for(int i = 0; i < Model.Receipt.Lines.Count(); i++){
                    var line = Model.Receipt.Lines[i];
                    <tr>
                        <td><input class="form-control col-1" id="received" type="text" value="@line.Received" disabled=""></td>
                        <td><input class="form-control col-1" id="orderedId" type="text" value="@line.Ordered" disabled=""></td>
                        <td><input class="form-control col-2" id="neoSkuId" type="text" value="@line.NeoSKU" disabled=""></td>
                        <td><input class="form-control col-7" id="nameId" type="text" value="@line.Description" disabled=""></td>
                    </tr>
                    lines++;
                }
                @for (int i = lines; i < 6; i++){
                    <tr>
                        <td><input class="form-control"  type="text" id="rec" name="rec" disabled=""/></td>
                        <td><input class="form-control" id="ord" type="text" value="" disabled=""></td>
                        <td><input class="form-control" id="neo" type="text" value=""  disabled=""></td>
                        <td><input class="form-control" id="name" type="text" value=""  disabled=""></td>
                    </tr>
                }
            </table>
        </div>
        @* Order List *@
        <div class="col-3">
            <br />
            <div class="h2" style="color:#a6e6ff; text-align:center;">RECEIPTS</div><br />
            <br />
            <div class="row list-outgoing">
                @foreach(ReceiptDTO r in Model.Receipts){
                    string? label;
                    if (r.OrderID.StartsWith("PR")){
                        label = $"{r.OrderID} - {r.Shipper} - {r.ReceiptID}";
                    }
                    else {
                        label = $"{r.OrderID} - {r.Recipient} - {r.ReceiptID}";
                    }
                    <a class="btn btn-secondary ps-2 pe-2" href="/shiprec/receipthistory/@r.ReceiptID">@label</a>
                
                <hr class="hr-slash"/>
                }
            </div>
        </div>
    </div>
    <br />
</div> 
