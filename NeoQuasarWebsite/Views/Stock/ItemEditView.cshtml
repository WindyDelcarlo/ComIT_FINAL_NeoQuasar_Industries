@model StockModel

@{
    ViewData["Title"] = Model.Item.NeoSKU + ": " + Model.Item.Name;
}

<div class="row">
    <div class="col"><h1>@Model.Item.Name</h1></div>
</div>
<div class="row">
    <div class="col-9">
            <div class="row">
                <div class="col-3">
                    <img src="~/img/@Model.Item.ImageLocation" class="img-fluid rounded mt-2 mb-2" style="border:2px solid black;" />
                </div>
                <div class="col-9">
                    @Model.Item.Description
                </div>
            </div>
            <div class="row">
                <div class="col-3" >
                    Current Stock: @Model.Item.Stock<br />
                    Price: @Model.Item.Price
                </div>
                <div>
                    <div class="col-3 ps-0 pe-0">
                                    <button class="btn btn-info">-</button>
                                </div>
                                <div class="col-5 ps-0 pe-0">
                                    <input class="form-control" type="text" id="qty" name="qty"
                                           value=@Model.StockInCart(@Model.Item) />
                                </div>
                                <div class="col-3 ps-0 pe-0">
                                    <button class="btn btn-info">+</button>
                                </div>
                </div>
            </div>
    </div>
    <div class="col-3 border border-3 ms-2 me-2 mt-2 mb-2 bg-dark rounded">
        <div class="h2" style="text-align:center;">DATA</h2>
        <hr />
        <b>Item SKU</b>: @Model.Item.NeoSKU
        <b>Manufacturer</b>: @Manufacturer.GetDatabase().FirstOrDefault(m => m.ManufacturerID == Model.Item.ManufacturerID)<br />
        <b>Manufacturer SKU:</b> @Model.Item.ManSKU<br /><br />
            @if (Model.Item.NeverRestock)
            {
                <div style="color:red;"><b>ITEM WILL NOT RESTOCK</b></div>
            }
        </div>
</div>