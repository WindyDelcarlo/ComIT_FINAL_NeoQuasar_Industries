@using NeoQuasarWebsite.Data
@model CheckOutModel

@{
    ViewData["Title"] = "Check Out";
    var formAction = ViewData[index: "FormAction"] as string ?? "CheckOut";
}

<div class="row">
    <div class="col-8">
    <form asp-action="@formAction" method="post">
        <div class="row">
            <div class="col-2">
                <h1>1</h1>
            </div>
            <div class="col-7">
                <h4>Shipping Address</h4>
                @if (User.Identity.IsAuthenticated){
                    <ul class="list-unstyled">
                        <li><input type="hidden" asp-for="AddressName" />@Model.AddressName</li>
                        <li><input type="hidden" asp-for="AddressStreet" />@Model.AddressStreet</li>
                        <li><input type="hidden" asp-for="LocatorCode" />@Model.LocatorCode</li>
                    </ul>
                }
                else {
                    <ul class="list-unstyled">
                        <li><input class="form-control" asp-for="AddressName"/></li>
                        <li><input class="form-control" asp-for="AddressStreet" /></li>
                        <li><input class="form-control" asp-for="LocatorCode" /></li>
                    </ul>
                }
            </div>
            <div class="col-3">
                @if (User.Identity.IsAuthenticated){
                <a href="/account/update" class="btn btn-info">Make Changes</a>
                }
            </div>
        </div>
        <hr class="hr-slash" />
        <div class="row">
            <div class="col-2">
                <h1>2</h1>
            </div>
            <div class="col-7">
                <h4>Payment Details</h4>
                @if (User.Identity.IsAuthenticated){
                    <ul class="list-unstyled">
                        <li><input type="hidden" asp-for="CardNumber" />@Model.CardNumber</li>
                        <li><input type="hidden" asp-for="ContactAddress" />@Model.ContactAddress</li>
                    </ul>
                }
                else {
                    <ul class="list-unstyled">
                        <li><input class="form-control" asp-for="CardNumber" /></li>
                        <li><input class="form-control" asp-for="ContactAddress" /></li>
                    </ul>
                }
            </div>
            <div class="col-3">
                @if (User.Identity.IsAuthenticated){
                <a href="/account/cards" class="btn btn-info">Make Changes</a>
                }
            </div>
        </div>
        <hr class="hr-slash" />
        <div class="row">
            <div class="col-2">
                <h1>3</h1>
            </div>
            <div class="col-10">
                <div class="form-check">
                    <label>
                    <input class="form-check-input" type="radio" asp-for="ShippingOption" value="0" id="radio-0" checked/>
                    @ShippingOptions.STANDARD
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="ShippingOption" value="1" id="radio-1"/>
                    <label>@ShippingOptions.EXPEDITED</label>
                </div>    
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="ShippingOption" value="2" id="radio-2"/>
                    <label asp-for="ShippingOption">
                        @ShippingOptions.EMERGENCY
                    </label>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col">
            <button class="btn btn-primary" type="submit">CHECK OUT</button>
            </div>
        </div>
        </form>
    </div>
    <div class="col-4">
        <h4>List:</h4>
        <table class="table-light w-100" style="border:2px table-layout:fixed;">
        @foreach(CartLineData cld in Model.user.Cart()){
            var item = StockItem.Get(cld.ItemSKU);
            var totalPrice = @item.Price * @cld.Quantity;
            <tr>
                <td style="width:80%;">@cld.Quantity x @item.Name</td>
                <td style="text-align:right; width:20%;">@totalPrice C</td>
            </tr>
        }
        </table>
        <hr class="hr-slash" />
        <table class="table-light w-100" style="border:2px; table-layout:fixed;">
            @{
                var subtotal = Model.CartTotal();
                var shipping = Model.GetShippingOptionCost();
                var tax = Model.GetTax();
                var total = subtotal * (1 + tax) + shipping;
            <tr>
                <td style="text-align:right; width:80%;">Subtotal: </td>
                <td style="text-align:right; width:20%;">@subtotal C</td>
            </tr>
            <tr>
                <td style="text-align:right; width:80%;">Shipping Fee: </td>
                <td style="text-align:right; width:20%;">@shipping C</td>
            </tr>
            <tr>
                <td style="text-align:right; width:80%;">Import Tax: </td>
                <td style="text-align:right; width:20%;">@tax C</td>
            </tr>
            <tr>
                <td style="text-align:right; width:80%;">Total: </td>
                <td style="text-align:right; width:20%;">@total C</td>
            </tr>
            }
        </table>
    </div>
</div>