@using NeoQuasarWebsite.Data
@model CheckOutModel

@{
    ViewData["Title"] = "Check Out";
    var formAction = ViewData[index: "FormAction"] as string ?? "CheckOut";
}

<div class="row" x-data="cart" x-init="init(true)">
    <div class="col-8">
        <form asp-action="@formAction" method="post">
            <div class="row">
                <div class="col-2">
                    <h1>1</h1>
                </div>
                <div class="col-7">
                    <h4>Shipping Address</h4>
                    @if (Model.Authenticated)
                    {
                        <ul class="list-unstyled">
                            <li><input type="hidden" asp-for="AddressName" />@Model.AddressName</li>
                            <li><input type="hidden" asp-for="AddressStreet" />@Model.AddressStreet</li>
                            <li><input type="hidden" asp-for="LocatorCode" />@Model.LocatorCode</li>
                        </ul>
                    }
                    else
                    {
                        <ul class="list-unstyled">
                            <li>
                                <div class="form-floating"><input class="form-control" asp-for="AddressName" />
                                    <label asp-for="AddressName"></label>
                                </div>
                            </li>
                            <li>
                                <div class="form-floating"><input class="form-control" asp-for="AddressStreet" />
                                    <label asp-for="AddressStreet"></label>
                                </div>
                            </li>
                            <li>
                                <div class="form-floating"><input class="form-control" asp-for="LocatorCode" x-model="locCode" x-on:change="updateTax()"/>
                                    <label asp-for="LocatorCode"></label>
                                </div>
                            </li>
                        </ul>
                    }
                </div>
                <div class="col-3">
                    @if (Model.Authenticated)
                    {
                        <a href="/account/update" class="btn btn-info">Make Changes</a>
                    }
                </div>
            </div>
            <hr class="hr-slash" />
            <div class="row">
                <div class="col-2">
                    <h1>2</h1>
                </div>
                <div class="col-7">
                    <h4>Payment Details</h4>
                    @if (Model.Authenticated)
                    {
                        <ul class="list-unstyled">
                            <li><input type="hidden" asp-for="CardNumber" />@Model.CardNumber</li>
                            <li><input type="hidden" asp-for="ContactAddress" />@Model.ContactAddress</li>
                        </ul>
                    }
                    else
                    {
                        <ul class="list-unstyled">
                            <li>
                                <li>
                                    <div class="form-floating">
                                        <input class="form-control" asp-for="CardNumber" />
                                        <label asp-for="CardNumber"></label>
                                    </div>
                                </li>
                                <li>
                                    <div class="form-floating"><input class="form-control" asp-for="ContactAddress" />
                                        <label asp-for="ContactAddress"></label>
                                    </div>
                                </li>
                            </ul>
                        }
                    </div>
                    <div class="col-3">
                        @if (Model.Authenticated)
                        {
                            <a href="/account/cards" class="btn btn-info">Make Changes</a>
                        }
                    </div>
                </div>
                <hr class="hr-slash" />
                <div class="row">
                    <div class="col-2">
                        <h1>3</h1>
                    </div>
                    <div class="col-10">
                        <div class="form-check">
                            <label>
                                <input class="form-check-input radio-shipping" type="radio" asp-for="ShippingOption"
                                       value="0" id="radio-0" x-model="shipping" checked />
                                @ShippingOptions.STANDARD
                            </label>
                            <br />
                            <label>
                                <input class="form-check-input radio-shipping" type="radio" asp-for="ShippingOption"
                                       value="1" id="radio-1" x-model="shipping" />
                                @ShippingOptions.EXPEDITED
                            </label>
                            <br />
                            <label>
                                <input class="form-check-input radio-shipping" type="radio" asp-for="ShippingOption"
                                       value="2" id="radio-2" x-model="shipping" />
                                @ShippingOptions.EMERGENCY</label>
                            </div>
                        </div>
                    </div>
        
                    <div class="row">
                        <div class="col">
                            <button class="btn btn-primary" type="submit">CHECK OUT</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="col-4">
                <h4>List:</h4>
        
