@model StockModel

@{
    ViewData["Title"] = Model.Item.NeoSKU + ": " + Model.Item.Name;
}

<div class="row">
    <div class="col">
        <h1>@Model.Item.Name</h1>
    </div>
</div>
<div class="row">
    <div class="col-8">
        <div class="row">
            <div class="col-3">
                @{
                    var imageAddress = Model.Item.Image;
                    if (!Uri.TryCreate(Model.Item.Image, UriKind.Absolute, out var imageUri)
                        || (imageUri.Scheme != Uri.UriSchemeHttp && imageUri.Scheme != Uri.UriSchemeHttps))
                    {
                        imageAddress = Url.Action("Get", "Image", new { fileName = Model.Item.Image }) ?? string.Empty;
                    }
                }
                <img src="@imageAddress" class="img-fluid rounded mt-2 mb-2"
                     style="border:2px solid black;" />
            </div>
            <div class="col-9">
                @Model.Item.Description
            </div>
        </div>
        <div class="row">
            <div class="col-6"></div>
            <div class="col-3">
                <b>Current Stock: @Model.Item.Stock<br />
                Price: @Model.Item.Price</b>
            </div>
            <div class="col-3">
                <div class="row gx-0">
                    <div class="col-10 offset-1 ps-0 pe-0 d-flex justify-center" x-data="stockitem" x-init="init(@Model.ItemJson())">
                        <button class="btn btn-info btn-remove" x-on:click="remove(item)">-</button>
                        <input class="form-control" type="text" x-model="item.cart" />
                        <button class="btn btn-info btn-add" x-on:click="add(item)">+</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-3 border border-3 me-2 mt-2 mb-2 rounded bg-primary text-light">
        <div class="display-2 pt-3" style="text-align:center;">DATA</div>
        <hr />
        <b>Category</b>: @Model.Item.Category<br />
        <b>Item SKU</b>: @Model.Item.NeoSKU<br />
        <b>Manufacturer</b>: @Model.Item.ManufacturerName<br />
        <b>Manufacturer SKU:</b> @Model.Item.ManufacturerSKU<br /><br />
        @if (Model.Item.NoRestock)
        {
            <div style="color:red;"><b>ITEM WILL NOT RESTOCK</b></div>
        }
    </div>
</div>
</div>