@model StockModel

@{
    ViewData["Title"] = Model.Item.NeoSKU + ": " + Model.Item.Name;
}

<div class="row">
    <div class="col">
        <h1>@Model.Item.Name</h1>
    </div>
</div>
<div class="row">
    <div class="col-8">
        <div class="row">
            <div class="col-3">
                <img src="~/img/@Model.Item.ImageLocation" class="img-fluid rounded mt-2 mb-2"
                     style="border:2px solid black;" />
            </div>
            <div class="col-9">
                @Model.Item.Description
            </div>
        </div>
        <div class="row">
            <div class="col-6"></div>
            <div class="col-3">
                <b>Current Stock: @Model.Item.Stock<br />
                Price: @Model.Item.Price</b>
            </div>
            <div class="col-3">
                <div class="row">
                    <div class="col-3 ps-0 pe-0">
                        <button class="btn btn-info btn-remove" data-itemid=@Model.Item.NeoSKU>-</button>
                    </div>
                    <div class="col-5 ps-0 pe-0">
                        <input class="form-control" type="text" id="qty-@Model.Item.NeoSKU" name="qty"
                               value=@Model.StockInCart(@Model.Item) />
                    </div>
                    <div class="col-3 ps-0 pe-0">
                        <button class="btn btn-info btn-add" data-itemid=@Model.Item.NeoSKU>+</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-3 border border-3 me-2 mt-2 mb-2 rounded bg-primary text-light">
        <div class="display-2 pt-3" style="text-align:center;">DATA</div>
        <hr />
        <b>Item SKU</b>: @Model.Item.NeoSKU<br />
        <b>Manufacturer</b>: @Manufacturer.GetDatabase().FirstOrDefault(m => m.ManufacturerID ==
                                Model.Item.ManufacturerID).Name<br />
        <b>Manufacturer SKU:</b> @Model.Item.ManSKU<br /><br />
        @if (Model.Item.NeverRestock)
        {
            <div style="color:red;"><b>ITEM WILL NOT RESTOCK</b></div>
        }
    </div>
</div>
</div>