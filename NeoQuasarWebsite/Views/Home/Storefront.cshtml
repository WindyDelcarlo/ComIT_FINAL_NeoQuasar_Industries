@model StorefrontModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="row"  x-data="storefront" x-init="init(@Model.SearchResultsJson())">
    @if (Model.SearchTerms.Count > 0)
    {
        <div class="row">
            <div class="col" style="text-align:center;">Showing @Model.SearchResultCount results for search:
                @foreach (string term in Model.SearchTerms)
                {
                    <i>@term, </i>
                }
            </div>
        </div>
    }
        <div class="d-flex flex-row" style="flex-wrap:wrap; justify-content:space-around; width:100%;">
            <template x-for="item in searchResults">
                <div class="col-5 border border-3 ps-2 pe-2 pt-2 pb-2 ms-2 me-2 mt-2 mb-2 bg-light rounded">
                    <div class="row">
                        <div class="col-3"><a :href="`/home/item/${item.sku}`"><img :src="`/img/${item.image}`" class="img-fluid rounded mt-2 mb-2" style="border:2px solid black;" /></a></div>
                        <div class="col-9"><br /><span x-text="item.description"></span></div>
                    </div>
                    <div class="row">
                        <div class="col-8">
                            <div class="h6"><a :href="`/home/item/${item.sku}`" x-text="item.name"></a></div>
                            <div x-text="`${item.manufacturer} - ${item.manufacturerSKU}`"></div>
                            <div><b x-text="item.sku"></b></div>
                        </div>
                        <div class="col-4">
                            <div class="row" style="text-align:right;">
                                <span x-text="`${item.price} Ω`"></span>
                            </div>
                            <div class="row">
                                <div class="col-3 ps-0 pe-0">
                                    <button class="btn btn-info btn-remove" x-on:click="remove(item)">-</button>
                                </div>
                                <div class="col-5 ps-0 pe-0">
                                    <input class="form-control" type="text" x-model="item.cart" />
                                </div>
                                <div class="col-3 ps-0 pe-0">
                                    <button class="btn btn-info btn-add" x-on:click="add(item)">+</button>
                                </div>
                            </div>
                            <div class="row" style="text-align:right;">
                                <span x-text="`(Stock: ${item.stock})`"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </template>
    </div>