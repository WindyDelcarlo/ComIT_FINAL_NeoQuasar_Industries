@{
    ViewData["Title"] = "Role Management";
}
<div class="container-fluid" x-data="roleManagement">
    <div class="row">
        <div class="col">
            <table class="table" style="text-align: center;">
                <thead>
                    <tr class="table-dark">
                        <th scope="col">ID</th>
                        <th scope="col">Name</th>
                        <th scope="col">Username</th>
                        <th scope="col">Contact</th>
                        <th scope="col">Role</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="table-dark">
                        <th colspan="5">
                            <input class="form-control" x-model="searchString" placeholder="Filter users..." x-on:input.debounce="updateList" />
                        </th>
                    </tr>
                    <template x-for="user in filteredList">
                        <tr class="table-dark">
                            <th scope="row" x-text="user.UserID"></th>
                            <td x-text="user.Name"></td>
                            <td x-text="user.Username"></td>
                            <td x-text="user.Contact"></td>
                            <td>
                                <select class="form-select" x-model="user.Role" x-on:change="roleSelect(user)">
                                    <option value="ADMIN">Admin</option>
                                    <option value="SHIPPER">Shipper</option>
                                    <option value="USER">User</option>
                                    <option value="none">N/A</option>
                                </select>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>
</div>
