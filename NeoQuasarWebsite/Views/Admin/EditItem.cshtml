@model StockEditViewModel

@{
    ViewData["Title"] = "Editing " + Model.Item.NeoSKU;
}

<div x-data="editItem(@Model.ItemJson())" x-init="init(@Model.ItemJson())">
        <div class="row">
            <div class="col">
                <div class="form-floating">
                    <input class="form-control" x-model="item.Name" x-on:keyup.enter="update()" x-on:blur="update()"/>
                    <label>Name</label><br />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-8">
                <div class="row">
                    <div class="col-4">
                        <form asp-action="EditItem" method="post" enctype="multipart/form-data">
                            <input type="file" asp-for="File" class="form-control" accept="image/*" /><br />
                            <button class="btn btn-info" type="submit">Save Image</button>
                        </form>
                    </div>
                    <div class="col-8">
                        <div class="form-floating">
                            <textarea class="form-control" x-model="item.Description" x-on:keyup.enter="update()" x-on:blur="update()"></textarea>
                            <label>Description</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-4">
                        <img :src="`/Image/Get?fileName=${item.Image}`" class="img-fluid rounded mt-2 mb-2"
                             style="border:2px solid black;" /></div>
                    <div class="col-3">
                        <div class="form-floating">
                            <input type="number" class="form-control" x-model="item.Price" x-on:keyup.enter="update()" x-on:blur="update()"/>
                            <label>Price</label>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="row">
                            <div class="col-5 ps-0 pe-0 form-floating">
                                <input class="form-control" type="number" x-model="item.Stock" x-on:keyup.enter="update()" x-on:blur="update()"/>
                                <label>Stock</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        
            <div class="col-3 border border-3 me-2 mt-2 mb-2 rounded bg-primary text-light">
                <div class="display-2 pt-3" style="text-align:center;">DATA</div>
                <hr />
                <select class="form-select" x-model="item.Category" x-on:change="catSelect(item)">
                    <option value="REACTOR">Reactor</option>
                    <option value="REACTOR_PART">Reactor Part</option>
                    <option value="QUANTUM_COMPUTER">Quantum Computer</option>
                    <option value="ARCANOHARMONIC_DRIVE">Arcanoharmonic Drive</option>
                    <option value="FLOWTECH">Flowtech</option>
                    <option value="SENSOR">Sensor</option>
                    <option value="COMPUTER">Computer</option>
                    <option value="DIMSPACE_THRUSTERS">Dimspace Thrusters</option>
                    <option value="MECHANICAL_PART">Mechanical Part</option>
                    <option value="FOOD_AND_DRINK">Food And Drink</option>
                    <option value="COMFORT">Comfort</option>
                    <option value="COMBAT">Combat</option>
                    <option value="LIFE_SUPPORT">Life Support</option>
                    <option value="TOOL">Tool</option>
                    <option value="MISC">Miscellaneous</option>
                </select>
                <b>Item SKU</b>: <span x-text="item.NeoSKU"></span><br />
                <b>Manufacturer</b>: <span x-text="item.Manufacturer"></span><br />
                <b>Manufacturer SKU:</b> <span x-text="item.ManufacturerSKU"></span><br /><br />
                <input class="form-check-input" type="checkbox" x-model="item.NoRestock" x-on:change="update()"/>
                <label class="form-check-label"><b>NEVER RESTOCK</b> </label>
        
            </div>
        </div>
</div>