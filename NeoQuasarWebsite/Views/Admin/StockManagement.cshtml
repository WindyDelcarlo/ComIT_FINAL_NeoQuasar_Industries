@using NeoQuasarWebsite.DTO
@model StockManagementModel

@{
    ViewData["Title"] = "Stock Management";
}

<div class="container-fluid">
    <div class="row">
        <div class="col">
            <table class="table table-responsive-sm text-nowrap" style="align-text:center; table-layout:fixed;">
                <thead>
                    <tr class="table-dark text-middle">
                        <th scope="col" style="width:12%;">NEO SKU</th>
                        <th scope="col" style="width:10%;">MANU SKU</th>
                        <th class="overflow-hidden" scope="col" style="width:25%;">NAME</th>
                        <th scope="col" style="15%;">MANUFACTURER</th>
                        <th scope="col" style=7%;>PRICE</th>
                        <th scope="col" style="width:16%;">CATEGORY</th>
                        <th scope="col" style="width:7%;">STOCK</th>
                        <th scope="col" style="width:8%;"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="table-dark">
                        <form action="" method="post">
                        <td></td>
                        <fieldset>
                        <td><input class="form-control" style="padding:0.75rem 0.5rem;" asp-for="ManSKU"/></td>
                        <td><input class="form-control" style="padding:0.75rem 0.5rem;" asp-for="Name" /></td>
                        <td><input class="form-control" style="padding:0.75rem 0.5rem;" asp-for="Manufacturer"/></td>
                        <td><input class="form-control" style="padding:0.75rem 0.5rem;" asp-for="Price"/></td>
                        <td>
                            <select asp-for="SelectedCategory" asp-items="Model.catList" style="padding:0.75rem 0.5rem;" class="form-select"></select>
                        </td>
                        <td><input class="form-control" asp-for="Stock" style="padding:0.75rem 0.5rem;" /></td>
                        </fieldset>
                        <td><button class="btn btn-primary">ADD</button></td>
                        </form>
                    
                    </tr>
                    @foreach(StockItemDTO item in Model.stockItems){
                        <tr class="table-dark">
                        <th scope="row" style="align-text:center;">@item.NeoSKU</th>
                        <td style="align-text:center;">@item.ManufacturerSKU</td>
                        <td>@item.Name</td>
                        <td>@item.ManufacturerName</td>
                        <td class="text-end">@item.Price</td>
                        <td>@item.Category</td>
                        <td style="align-text:center;">@item.Stock</td>
                        <td><a href="/admin/edititem/@item.NeoSKU" class="btn btn-primary">EDIT</a></td>
                        </tr>
                    }
                </tbody>
            </table> 
        </div>
    </div>
</div>