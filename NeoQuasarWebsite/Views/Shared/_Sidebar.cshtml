@using System.Security.Claims

<div class="offcanvas-body">
    @if (User.Identity.IsAuthenticated)
    {
        <div class="row">
            <div class="col-12">
                Signed in as @User.FindFirstValue(ClaimTypes.Name)
            </div>
        </div>
    }
    <div class="row">
        @if (User.Identity.IsAuthenticated)
        {
            <div class="col-6">
                <a class="nav-link text-light" asp-area="" asp-controller="Account"
                   asp-action="AccountDetails">Account...</a>
            </div>
            <div class="col-6">
                <a class="nav-link text-light" asp-area="" asp-controller="Account" asp-action="LogOut">Log Out</a>
            </div>
        }
        else
        {
            <div class="col-12">
                <a class="nav-link text-light" asp-area="" asp-controller="Account" asp-action="LogIn">Log In</a>
            </div>
        }
    </div>
    <ul class="navbar-nav flex-grow-1">
        <hr class="hr-slash" />
        <hr class="hr-slash" />
        <li class="nav-item">
            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Storefront">Home</a>
        </li>
        @if (User.Identity.IsAuthenticated)
        {
            @if (User.FindFirstValue(ClaimTypes.Role) == UserRole.SHIPPER.ToString()
            || User.FindFirstValue(ClaimTypes.Role) == UserRole.ADMIN.ToString())
            {
                <hr class="hr-slash" />
                <li class="nav-item">
                    <a class="nav-link text-light" asp-area="" asp-controller="ShipRec" asp-action="PendingOrders">Pending
                        Orders</a>
                    </li>
                    <hr class="hr-slash" />
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-area="" asp-controller="ShipRec" asp-action="ReceiptHistory">Receipt
                            History</a>
                        </li>
                    }
                    @if (User.FindFirstValue(ClaimTypes.Role) == UserRole.ADMIN.ToString())
                    {
                        <hr class="hr-slash" />
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Admin" asp-action="StockManagement">Stock
                                Management</a>
                        </li>
                        <hr class="hr-slash" />
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Admin" asp-action="RoleManagement">Role
                                Management</a>
                        </li>
                        <hr class="hr-slash" />
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Admin" asp-action="Manufacturers">Manufacturers</a>
                        </li>
                            }
                        }
                    </ul>
                </div>