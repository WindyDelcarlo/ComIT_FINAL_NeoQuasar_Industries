@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">

@{
    int userId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "0");
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NeoQuasarWebsite</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/lux/css/bootstrap.min.css"  rel="stylesheet" crossorigin="anonymous"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NeoQuasarWebsite.styles.css" asp-append-version="true" />
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.17.4/dist/cdn.min.js"></script>
</head>

<body>
    <header>

        <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
            <div class="container-fluid">
                <div class="col-3">
                    <div class="row">
                        <div class="col-3">
                            <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas"
                                    data-bs-target="#offcanvasExample" aria-controls="offcanvasExample">
                                <span class="navbar-toggler-icon"></span>
                            </button>
                        </div>

                        <div class="col-9">
                            <a href="~/home/storefront"><img src="~/img/logo.png" class="img-fluid rounded mt-2 mb-2" /></a>
                        </div>
                    </div>
                </div>
                <div class="col-8">
                    <form action="~/Home/Storefront" method="get">
                    <div class="collapse navbar-collapse ms-2 ps-4 pe-4 me-2" id="navbarColor01">
                            <input class="form-control" type="search" name="search" placeholder="Search for inventory..." />
                            <button class="btn btn-primary" type="submit">Search</button>
                    </div>
                    </form>
                </div>
                <div class="col-1">
                    <a href="~/home/cart/@userId"><img src="~/img/CartIcon.png" class="img-fluid rounded mt-2 mb-2" /></a>
                </div>
            </div>
        </div>
    </nav>
    <div class="container-fluid bg-primary" data-bs-theme="dark">
        <div class="row" style="height:30px">
            <hr class="hr-slash" />
        </div>
    </div>

    <div class="offcanvas offcanvas-start bg-primary" tabindex="-1" data-bs-start="true" id="offcanvasExample"
         aria-labelledby="offcanvasExampleLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-light" id="offcanvasExampleLabel">NAVBAR</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <partial name="_Sidebar" />
        </header>
        <div class="container-fluid bg-body-tertiary">
            <br />
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - NEO Quasar Industries
            </div>
        </footer>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>
