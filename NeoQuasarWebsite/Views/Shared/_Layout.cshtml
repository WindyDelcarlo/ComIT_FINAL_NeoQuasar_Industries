@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">

@{
    int userId = 1;
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NeoQuasarWebsite</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/lux/css/bootstrap.min.css"  rel="stylesheet" crossorigin="anonymous"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NeoQuasarWebsite.styles.css" asp-append-version="true" />
</head>

<body>
    <header>

        <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
            <div class="container-fluid">
                <div class="col-3">
                    <div class="row">
                        <div class="col-3">
                            <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas"
                                    data-bs-target="#offcanvasExample" aria-controls="offcanvasExample">
                                <span class="navbar-toggler-icon"></span>
                            </button>
                        </div>

                        <div class="col-9">
                            <a href="~/home/storefront"><img src="~/img/logo.png" class="img-fluid rounded mt-2 mb-2" /></a>
                        </div>
                    </div>
                </div>
                <div class="col-8">
                    <div class="row"></div>
                    <div class="col-1"></div>
                    <div class="collapse navbar-collapse ms-2 ps-4 pe-4 me-2" id="navbarColor01">
                        <input class="form-control" type="search" placeholder="Search for inventory...">
                        <button class="btn btn-primary" type="submit">Search</button>
                    </div>
                </div>
                <div class="col-1">
                    <a href="~/home/cart/@userId"><img src="~/img/CartIcon.png" class="img-fluid rounded mt-2 mb-2" /></a>
                </div>
            </div>
        </div>
    </nav>
    <div class="container-fluid bg-primary" data-bs-theme="dark">
        <div class="row" style="height:30px">
            <hr class="hr-slash" />
        </div>
    </div>

    <div class="offcanvas offcanvas-start bg-primary" tabindex="-1" data-bs-start="true" id="offcanvasExample"
         aria-labelledby="offcanvasExampleLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-light" id="offcanvasExampleLabel">NAVBAR</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            @if(User.Identity.IsAuthenticated){
            <div class="row">
                <div class="col-12">
                    Signed in as @UserModel.GetUser(User.FindFirstValue(ClaimTypes.NameIdentifier)).Username
                </div>
            </div>
            }
            <div class="row">
                @if(User.Identity.IsAuthenticated){
                <div class="col-6">
                    <a class="nav-link text-light" asp-area="" asp-controller="Account" asp-action="AccountDetails">Account...</a>
                </div>
                <div class="col-6">
                    <a class="nav-link text-light" asp-area="" asp-controller="Account" asp-action="LogOut">Log Out</a>
                </div>
                }
                else {
                <div class="col-12">
                    <a class="nav-link text-light" asp-area="" asp-controller="Account" asp-action="LogIn">Log In</a>
                </div>
                }
            </div>
            <ul class="navbar-nav flex-grow-1">
                <hr class="hr-slash" />
                <hr class="hr-slash" />
                <li class="nav-item">
                    <a class="nav-link text-light" asp-area="" asp-controller="Home"
                       asp-action="Storefront">Home</a>
                </li>
                @if (UserModel.GetUser(User.FindFirstValue(ClaimTypes.NameIdentifier)).UserRole == UserRole.SHIPPER 
                || UserModel.GetUser(User.FindFirstValue(ClaimTypes.NameIdentifier)).UserRole == UserRole.ADMIN){
                <hr class="hr-slash" />
                <li class="nav-item">
                    <a class="nav-link text-light" asp-area="" asp-controller="Home"
                       asp-action="PendingOrders">Pending Orders</a>
                </li>
                <hr class="hr-slash" />
                <li class="nav-item">
                    <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="ReceiptHistory">Receipt
                        History</a>
                    </li>
                }
                @if (UserModel.GetUser(User.FindFirstValue(ClaimTypes.NameIdentifier)).UserRole == UserRole.ADMIN){
                <hr class="hr-slash" />
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-area="" asp-controller="Stock"
                           asp-action="StockManagement">Stock Management</a>
                    </li>
                <hr class="hr-slash" />
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-area="" asp-controller="Home"
                           asp-action="RoleManagement">Role Management</a>
                    </li>
                <hr class="hr-slash" />
                }
                </ul>
            </div>
        </header>
        <div class="container-fluid">
            <br />
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - NEO Quasar Industries
            </div>
        </footer>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>
