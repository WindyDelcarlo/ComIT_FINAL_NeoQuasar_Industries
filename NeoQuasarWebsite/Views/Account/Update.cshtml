@using NeoQuasarWebsite.Data
@model AccountDetailsModel

@{
    ViewData["Title"] = "Editing Account Details";
}
@{
    var errorMessage = ViewData["ErrorMessage"] as string;
    var successMessage = ViewData["SuccessMessage"] as string;
}

<div class="row">
    @if (!string.IsNullOrWhiteSpace(errorMessage)){
    <div class="row">
        <div class="col">>
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        </div>
    </div>
    }
    <div class="col-6 offset-1" style="font-weight:700">
        <form action="" method="post">
            <div class="form-floating">
                <input type="text" class="form-control" id="name" name="name" value="@UserModel.GetUser(Model.UserID).Name" />
                <label for="name">Name</label>
            </div><br />
            <div class="form-floating">
                <input type="text" class="form-control" id="stellarNet" name="stellarNet" value="@UserModel.GetUser(Model.UserID).StellarNet" />
                <label for="stellarNet">stellarNet</label>
            </div><br />
            <div class="form-floating">
                <input type="text" class="form-control" id="slingName" name="slingName" value="@UserModel.GetUser(Model.UserID).SlingName" />
                <label for="slingName">Sling Name</label>
            </div><br />
            <button class="btn btn-primary" type="submit">SAVE</button>
        </form>

        @*
        <ul class="list-unstyled">
            @if(Model.user.StellarNet != null && Model.user.StellarNet != ""){
                <li>@Model.user.StellarNet</li>
            }
            else {
                <li>sN: Unassigned</li>
            }
            @if(Model.user.SlingName != null && Model.user.SlingName != ""){
                <li><img src="~/img/slinglogo.png" class="img-fluid rounded mt-2 mb-2" />: @Model.user.SlingName</li>
            }
            else {
                <li><img src="~/img/slinglogo.png" class="img-fluid rounded mt-2 mb-2" />: Unassigned</li>
            }
            <li><a href="/account/update">Update Details (WIP)</a></li>
            <li><a href="/account/password">Change Password (WIP)</a></li>
        </ul> *@
        <hr class="hr-slash" style="background-color:black" />
        <div class="h2">Payment Details: @PaymentDetails.GetDatabase().Where(pd => pd.UserId == Model.UserID).Count() Card(s) Found</div>
        @if (@PaymentDetails.GetDatabase().Where(pd => pd.UserId == Model.UserID).Count() > 0){
            foreach(PaymentDetailData pd in @PaymentDetails.GetDatabase().Where(pd => pd.UserId == Model.UserID)){
            <div class="row align-items-center">
                <div class="col-4">
                    <img src="~/@pd.GetImagePath()" class="img-fluid rounded mt-2 mb-2" />
                </div>
                <div class="col-8">
                    <ul class="list-unstyled">
                        @switch(pd.CardType){
                            case "STELLARNET_DEBIT": {
                                <li class="display-3">stellarNet Debit</li>
                                break;
                            }
                            case "CREDIT": {
                                <li class="display-3">Interdim Credit</li>
                                break;
                            }
                            default: {
                                <li class="display-3">Requisitions Account</li>
                                break;
                            }
                        }
                        <li class="display-3">@pd.CardName</li>
                        <li class="display-3">@pd.CardNumber</li>
                    </ul>
                </div>
                <hr class="hr-slash" style="background-color:black" />
            </div>
            }
        }
    </div>
    <div class="col-4">
        <div class="h2">Order History</div>
        <hr class="hr-slash" style="background-color:black" />
        @for (int i = Order.GetDatabase().Where(o => o.UserID == Model.UserID).Count(); i > 0; i--){
            var orderDatabase = Order.GetDatabase().Where(o => o.UserID == Model.UserID).ToList();
            Order o = new Order(orderDatabase[i-1]);
            if (o.UserID == Model.UserID && Model.OrderNumber < 5){
                Model.OrderNumber++;
                <div class="h3">Order @o.ID</div>
                <ul class="list-unstyled">
                    <li>Ordered on: @o.Date</li>
                    <ul>
                        @foreach(OrderLineData old in LineItem.OrderLineDatabase().Where(old => old.OrderID == o.ID)){
                            var item = StockItem.Get(old.ItemSKU);
                        <li>
                            <div class="row">
                            <div class="col-9 overflow-hidden">@old.AmountOrdered x @item.NeoSKU @item.Name</div>
                            <div class="col-3 text-end text-nowrap">@(item.Price * old.AmountOrdered) C</div>
                            </div>
                        </li>
                        }
                    </ul>
                        <li>
                            <div class="row">
                            <div class="col-9 text-end">TOTAL</div>
                            <div class="col-3 text-end text-nowrap">@o.GetTotalPrice() C</div>
                            </div>
                        </li>
                </ul>
                <hr class="hr-slash" style="background-color:black" />
            }
        }
    </div>
    <div class="col-1">
    </div>
</div>