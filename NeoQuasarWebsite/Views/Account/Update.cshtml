@using NeoQuasarWebsite.DTO
@using NeoQuasarWebsite.Data
@model AccountDetailsViewModel

@{
    ViewData["Title"] = "Editing Account Details";
}

<div class="row">
    <div class="col-6 offset-1" style="font-weight:700">
        <form action="Update" method="post">
            <div class="form-floating">
                <input type="text" class="form-control" id="name" name="name" value="@Model.User.Name" />
                <label for="name">Name</label>
            </div><br />
            <div class="form-floating">
                <input type="text" class="form-control" id="stellarNet" name="stellarNet" value="@Model.User.StellarNet" />
                <label for="stellarNet">stellarNet</label>
            </div><br />
            <div class="form-floating">
                <input type="text" class="form-control" id="slingName" name="slingName" value="@Model.User.SlingName" />
                <label for="slingName">Sling Name</label>
            </div><br />
            <div class="form-floating">
                <input type="text" class="form-control" id="address" name="address" value="@Model.User.Address" />
                <label for="address">Address</label>
            </div><br />
            <div class="form-floating">
                <input type="text" class="form-control" id="locatorCode" name="locatorCode" value="@Model.User.LocatorCode" />
                <label for="locatorCode">LOC Code</label>
            </div><br />
            <button class="btn btn-primary" type="submit">SAVE</button>
        </form>
        <hr class="hr-slash" style="background-color:black" />
        <partial name="_PaymentDetails" />
    </div>
    <div class="col-5">
        <partial name="_OrderHistory" />
    </div>
    <div class="col-1">
    </div>
</div>