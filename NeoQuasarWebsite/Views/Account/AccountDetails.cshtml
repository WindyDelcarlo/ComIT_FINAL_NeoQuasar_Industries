@using NeoQuasarWebsite.DTO
@using NeoQuasarWebsite.Data
@model AccountDetailsModel

@{
    ViewData["Title"] = "Account Details";
}

<div class="row">

    <div class="col-6 offset-1" style="font-weight:700">
        <div class="h1">@Model.User.Name</div>
        <ul class="list-unstyled">
            @if (!string.IsNullOrWhiteSpace(Model.User.StellarNet))
            {
                <li>sN: @Model.User.StellarNet</li>
            }
            else
            {
                <li>sN: Unassigned</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.User.SlingName))
            {
                <li><img src="~/img/slinglogo.png" class="img-fluid rounded mt-2 mb-2" />: @@@Model.User.SlingName</li>
            }
            else
            {
                <li><img src="~/img/slinglogo.png" class="img-fluid rounded mt-2 mb-2" />: Unassigned</li>
            }
            <li><a href="/account/update/">Update Details</a></li>
            <li><a href="/account/password/">Change Password</a></li>
            <li><a href="#deleteAccountModal" data-bs-toggle="modal" >Delete Account</a></li>
        </ul>
        <hr class="hr-slash" style="background-color:black" />
        <div class="h2">Payment Details: @Model.paymentData.Count() Card(s) Found</div>
        <div class="display-4"><a href="/account/cards/">Add or Remove a Card...</a></div>
        @if (Model.paymentData.Count() > 0)
        {
            foreach (PaymentDTO pd in Model.paymentData)
            {
                <div class="row align-items-center">
                    <div class="col-4">
                        <img src="~/@pd.Image" class="img-fluid rounded mt-2 mb-2" />
                    </div>
                    <div class="col-8">
                        <ul class="list-unstyled">
                            <li class="display-3">@pd.CardName @if(pd.Selected) {
                                <span>[selected]</span>
                            }
                        </li>
                        @switch (pd.CardType)
                        {
                            case "STELLARNET_DEBIT":
                                {
                                    <li class="display-4">stellarNet Debit</li>
                                    break;
                                }
                            case "CREDIT":
                                {
                                    <li class="display-4">Interdim Credit</li>
                                    break;
                                }
                            default:
                                {
                                    <li class="display-4">Requisitions Account</li>
                                    break;
                                }
                        }
                        <li class="display-4">@pd.CardNumber</li>
                    </ul>
                </div>
                <hr class="hr-slash" style="background-color:black" />
            </div>
            }
        }
</div>
<div class="col-5">
    <div class="h2">Order History</div>
    <hr class="hr-slash" style="background-color:black" />
    @foreach (OrderDTO o in Model.orderData)
    {
        if (Model.OrderNumber < 5)
        {
            Model.OrderNumber++;
            <div class="h3">Order @o.ID</div>
            <ul class="list-unstyled">
                <li>Ordered on: @o.Date</li>
                <ul>
                    @foreach (LineDTO line in o.lines)
                    {
                        <li>
                            <div class="row">
                                <div class="col-9 overflow-hidden">@line.Ordered x @line.NeoSKU @line.Description</div>
                                <div class="col-3 text-end text-nowrap">@(line.Price * line.Ordered) C</div>
                            </div>
                        </li>
                    }
                </ul>
                <li>
                    <div class="row">
                        <div class="col-9 text-end">TOTAL</div>
                        <div class="col-3 text-end text-nowrap">@o.TotalPrice C</div>
                    </div>
                </li>
            </ul>
            <hr class="hr-slash" style="background-color:black" />
        }
    }
</div>
<div class="col-1">
</div>
</div>

<div class="modal" id="deleteAccountModal">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Delete your account?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
          <span aria-hidden="true"></span>
        </button>
      </div>
      <div class="modal-body">
        <div>This action cannot be undone.</div>
      </div>
      <div class="modal-footer">
        <a href="/account/delete"><button type="button" class="btn btn-danger">Delete</button></a>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>