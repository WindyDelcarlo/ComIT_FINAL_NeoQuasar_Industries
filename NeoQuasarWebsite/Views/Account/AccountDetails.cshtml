@using NeoQuasarWebsite.DTO
@using NeoQuasarWebsite.Data
@model AccountDetailsViewModel

@{
    ViewData["Title"] = "Account Details";
}

<div class="row">

    <div class="col-6 offset-1" style="font-weight:700">
        <partial name="_AccountInfo" />
        <hr class="hr-slash" style="background-color:black" />
        <partial name="_PaymentDetails" />
</div>
<div class="col-5">
    <partial name="_OrderHistory" />
</div>
<div class="col-1">
</div>
</div>

<div class="modal" id="deleteAccountModal">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Delete your account?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
          <span aria-hidden="true"></span>
        </button>
      </div>
      <div class="modal-body">
        <div>This action cannot be undone.</div>
      </div>
      <div class="modal-footer">
        <a href="/account/delete"><button type="button" class="btn btn-danger">Delete</button></a>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>