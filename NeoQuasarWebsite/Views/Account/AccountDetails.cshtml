@using NeoQuasarWebsite.Data
@model AccountDetailsModel

@{
    ViewData["Title"] = "Account Details";
}
@{
    var errorMessage = ViewData["ErrorMessage"] as string;
    var successMessage = ViewData["SuccessMessage"] as string;
}

<div class="row">
    @if (!string.IsNullOrWhiteSpace(successMessage)){
    <div class="row">
        <div class="col">
        <div class="alert alert-success" role="alert">@successMessage</div>
        </div>
    </div>
    }
    <div class="col-6 offset-1" style="font-weight:700">
        <div class="h1">@UserModel.GetUser(Model.UserID).Name</div>
        <ul class="list-unstyled">
            @if(@UserModel.GetUser(Model.UserID).StellarNet != null && @UserModel.GetUser(Model.UserID).StellarNet != ""){
                <li>sN: @UserModel.GetUser(Model.UserID).StellarNet</li>
            }
            else {
                <li>sN: Unassigned</li>
            }
            @if(UserModel.GetUser(Model.UserID).SlingName != null && UserModel.GetUser(Model.UserID).SlingName != ""){
                <li><img src="~/img/slinglogo.png" class="img-fluid rounded mt-2 mb-2" />: @@@UserModel.GetUser(Model.UserID).SlingName</li>
            }
            else {
                <li><img src="~/img/slinglogo.png" class="img-fluid rounded mt-2 mb-2" />: Unassigned</li>
            }
            <li><a href="/account/update/">Update Details</a></li>
            <li><a href="/account/password/">Change Password (WIP)</a></li>
        </ul>
        <hr class="hr-slash" style="background-color:black" />
        <div class="h2">Payment Details: @PaymentDetails.GetDatabase().Where(pd => pd.UserId == Model.UserID).Count() Card(s) Found</div>
        <div class="display-4"><a href="/account/cards/">Add or Remove a Card...</a></div>   
        @if (PaymentDetails.GetDatabase().Where(pd => pd.UserId == Model.UserID).Count() > 0){
            foreach(PaymentDetailData pd in PaymentDetails.GetDatabase().Where(pd => pd.UserId == Model.UserID)){
            <div class="row align-items-center">
                <div class="col-4">
                    <img src="~/@pd.GetImagePath()" class="img-fluid rounded mt-2 mb-2" />
                </div>
                <div class="col-8">
                    <ul class="list-unstyled">
                        <li class="display-3">@pd.CardName @if(pd.PaymentDetailID == UserModel.GetUser(Model.UserID).SelectedCard) { <span>[selected]</span> }</li>
                        @switch(pd.CardType){
                            case "STELLARNET_DEBIT": {
                                <li class="display-4">stellarNet Debit</li>
                                break;
                            }
                            case "CREDIT": {
                                <li class="display-4">Interdim Credit</li>
                                break;
                            }
                            default: {
                                <li class="display-4">Requisitions Account</li>
                                break;
                            }
                        }
                        <li class="display-4">@pd.CardNumber</li>
                    </ul>
                </div>
                <hr class="hr-slash" style="background-color:black" />
            </div>
            }
        }
    </div>
    <div class="col-5">
        <div class="h2">Order History</div>
        <hr class="hr-slash" style="background-color:black" />
        @for (int i = Order.GetDatabase().Where(o => o.UserID == Model.UserID).Count() - 1; i >= 0; i--){
            var orderDatabase = Order.GetDatabase().Where(o => o.UserID == Model.UserID).ToList();
            Order o = new Order(orderDatabase[i]);
            if (o.UserID == Model.UserID && Model.OrderNumber < 5){
                Model.OrderNumber++;
                <div class="h3">Order @o.ID</div>
                <ul class="list-unstyled">
                    <li>Ordered on: @o.Date</li>
                    <ul>
                        @foreach(OrderLineData old in LineItem.OrderLineDatabase().Where(old => old.OrderID == o.ID)){
                            var item = StockItem.Get(old.ItemSKU);
                        <li>
                            <div class="row">
                            <div class="col-9 overflow-hidden">@old.AmountOrdered x @item.NeoSKU @item.Name</div>
                            <div class="col-3 text-end text-nowrap">@(item.Price * old.AmountOrdered) C</div>
                            </div>
                        </li>
                        }
                    </ul>
                        <li>
                            <div class="row">
                            <div class="col-9 text-end">TOTAL</div>
                            <div class="col-3 text-end text-nowrap">@o.GetTotalPrice() C</div>
                            </div>
                        </li>
                </ul>
                <hr class="hr-slash" style="background-color:black" />
            }
        }
    </div>
    <div class="col-1">
    </div>
</div>