@using NeoQuasarWebsite.DTO
@using NeoQuasarWebsite.Data
@model AddingPaymentsModel

@{
    ViewData["Title"] = "Adding Payment Methods";
}
@{
    var formAction = ViewData[index: "FormAction"] as string ?? "Cards";
}

<div class="row">
    <div class="col-6 offset-1" style="font-weight:700">
        <div class="h1">@Model.User.Name</div>
        <ul class="list-unstyled">
            @if (!string.IsNullOrWhiteSpace(Model.User.StellarNet))
            {
                <li>sN: @Model.User.StellarNet</li>
            }
            else
            {
                <li>sN: Unassigned</li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.User.SlingName))
            {
                <li><img src="~/img/slinglogo.png" class="img-fluid rounded mt-2 mb-2" />: @@@Model.User.SlingName</li>
            }
            else
            {
                <li><img src="~/img/slinglogo.png" class="img-fluid rounded mt-2 mb-2" />: Unassigned</li>
            }
            <li><a href="/account/update/">Update Details</a></li>
            @* <li><a href="/account/password/">Change Password (WIP)</a></li> *@
        </ul>

        <hr class="hr-slash" style="background-color:black" />
        
        <div class="h2">Payment Details: @Model.paymentData.Count() Card(s) Found</div>
            <form asp-action="@formAction" method="post">
                <div class="form-floating">
                    <input asp-for="CardName" class="form-control" />
                    <label asp-for="CardName"></label>
                    <span asp-validation-for="CardName" class="text-danger"></span>
                </div>
                <br />
                <div class="form-floating">
                    <input asp-for="CardNumber" class="form-control"/>
                    <label asp-for="CardNumber"></label>
                    <span asp-validation-for="CardNumber" class="text-danger"></span>
                </div>
                <br />
                <div>
                    <select asp-for="CardType" asp-items="Model.typeList" class="form-select"></select>
                </div>
                <br />

                <button class="btn btn-primary py-2" type="submit">ADD CARD</button>
            </form>
        <br />
        @if (Model.paymentData.Count() > 0)
        {
            foreach (PaymentDTO pd in Model.paymentData)
            {
                <div class="row align-items-center">
                    <div class="col-4">
                        <img src="~/@pd.Image" class="img-fluid rounded mt-2 mb-2" />
                    </div>
                    <div class="col-8">
                        <ul class="list-unstyled">
                            <li class="display-3">@pd.CardName @if(pd.Selected) {
                                <span>[selected]</span>
                            }
                        </li>
                        @switch (pd.CardType)
                        {
                            case "STELLARNET_DEBIT":
                                {
                                    <li class="display-4">stellarNet Debit</li>
                                    break;
                                }
                            case "CREDIT":
                                {
                                    <li class="display-4">Interdim Credit</li>
                                    break;
                                }
                            default:
                                {
                                    <li class="display-4">Requisitions Account</li>
                                    break;
                                }
                        }
                        <li class="display-4">@pd.CardNumber</li>
                        <li><button class="btn btn-info card-select" data-id="@pd.CardID" >SELECT</button></li>
                    </ul>
                </div>
                <hr class="hr-slash" style="background-color:black" />
            </div>
            }
        }
    </div>
    <div class="col-5">
    <div class="h2">Order History</div>
    <hr class="hr-slash" style="background-color:black" />
    @foreach (OrderDTO o in Model.orderData)
    {
        if (Model.OrderNumber < 5)
        {
            Model.OrderNumber++;
            <div class="h3">Order @o.ID</div>
            <ul class="list-unstyled">
                <li>Ordered on: @o.Date</li>
                <ul>
                    @foreach (LineDTO line in o.lines)
                    {
                        <li>
                            <div class="row">
                                <div class="col-9 overflow-hidden">@line.Ordered x @line.NeoSKU @line.Description</div>
                                <div class="col-3 text-end text-nowrap">@(line.Price * line.Ordered) C</div>
                            </div>
                        </li>
                    }
                </ul>
                <li>
                    <div class="row">
                        <div class="col-9 text-end">TOTAL</div>
                        <div class="col-3 text-end text-nowrap">@o.TotalPrice C</div>
                    </div>
                </li>
            </ul>
            <hr class="hr-slash" style="background-color:black" />
        }
    }
</div>
<div class="col-1">
</div>
</div>

<div class="modal" id="deleteCardModal">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Delete Card?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
          <span aria-hidden="true"></span>
        </button>
      </div>
      <div class="modal-body">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger btn-delete-card">Delete</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>