@using NeoQuasarWebsite.Data
@model AddingPaymentsModel

@{
    ViewData["Title"] = "Adding Payment Methods";
}
@{
    var errorMessage = TempData["ErrorMessage"] as string;
    var successMessage = TempData["SuccessMessage"] as string;
    var formAction = ViewData[index: "FormAction"] as string ?? "Cards";
}

<div class="row">
    @if (!string.IsNullOrWhiteSpace(errorMessage)){
    <div class="row">
        <div class="col-10 offset-1">>
        <div class="alert alert-danger" role="alert">@errorMessage</div>
        </div>
    </div>
    }
    <div class="col-6 offset-1" style="font-weight:700">
        <ul class="list-unstyled">
            @if(@UserModel.GetUser(Model.UserID).StellarNet != null && @UserModel.GetUser(Model.UserID).StellarNet != ""){
                <li>sN: @UserModel.GetUser(Model.UserID).StellarNet</li>
            }
            else {
                <li>sN: Unassigned</li>
            }
            @if(UserModel.GetUser(Model.UserID).SlingName != null && UserModel.GetUser(Model.UserID).SlingName != ""){
                <li><img src="~/img/slinglogo.png" class="img-fluid rounded mt-2 mb-2" />: @@@UserModel.GetUser(Model.UserID).SlingName</li>
            }
            else {
                <li><img src="~/img/slinglogo.png" class="img-fluid rounded mt-2 mb-2" />: Unassigned</li>
            }
            <li><a href="/account/update/@UserModel.GetUser(Model.UserID).UserID">Update Details</a></li>
            <li><a href="/account/password/@UserModel.GetUser(Model.UserID).UserID">Change Password (WIP)</a></li>
        </ul>

        <hr class="hr-slash" style="background-color:black" />
        
        <div class="h2">Payment Details: @PaymentDetails.GetDatabase().Where(pd => pd.UserId == Model.UserID).Count() Card(s) Found</div>
            <form asp-action="@formAction" method="post">
                <div class="form-floating">
                    <input asp-for="CardName" class="form-control" />
                    <label asp-for="CardName"></label>
                    <span asp-validation-for="CardName" class="text-danger"></span>
                </div>
                <br />
                <div class="form-floating">
                    <input asp-for="CardNumber" class="form-control"/>
                    <label asp-for="CardNumber"></label>
                    <span asp-validation-for="CardNumber" class="text-danger"></span>
                </div>
                <br />
                <div>
                    <select asp-for="CardType" asp-items="Model.typeList" class="form-select"></select>
                </div>
                <br />

                <button class="btn btn-primary py-2" type="submit">ADD CARD</button>
            </form>
        <br />
        @if (@PaymentDetails.GetDatabase().Where(pd => pd.UserId == Model.UserID).Count() > 0){
            foreach(PaymentDetailData pd in @PaymentDetails.GetDatabase().Where(pd => pd.UserId == Model.UserID)){
            <div class="row align-items-center">
                <div class="col-4">
                    <img src="~/@pd.GetImagePath()" class="img-fluid rounded mt-2 mb-2" />
                </div>
                <div class="col-8">
                    <ul class="list-unstyled">
                        <li class="display-3">@pd.CardName <span style="color: red; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#deleteCardModal" data-id="@pd.PaymentDetailID">[X]</span></li>
                        @switch(pd.CardType){
                            case "STELLARNET_DEBIT": {
                                <li class="display-4">stellarNet Debit</li>
                                break;
                            }
                            case "CREDIT": {
                                <li class="display-4">Interdim Credit</li>
                                break;
                            }
                            default: {
                                <li class="display-4">Requisitions Account</li>
                                break;
                            }
                        }
                        <li class="display-4">@pd.CardNumber</li>
                    </ul>
                </div>
                <hr class="hr-slash" style="background-color:black" />
            </div>
            }
        }
    </div>
    <div class="col-4">
        <div class="h2">Order History</div>
        <hr class="hr-slash" style="background-color:black" />
        @for (int i = Order.GetDatabase().Where(o => o.UserID == Model.UserID).Count(); i > 0; i--){
            var orderDatabase = Order.GetDatabase().Where(o => o.UserID == Model.UserID).ToList();
            Order o = new Order(orderDatabase[i-1]);
            if (o.UserID == Model.UserID && Model.OrderNumber < 5){
                Model.OrderNumber++;
                <div class="h3">Order @o.ID</div>
                <ul class="list-unstyled">
                    <li>Ordered on: @o.Date</li>
                    <ul>
                        @foreach(OrderLineData old in LineItem.OrderLineDatabase().Where(old => old.OrderID == o.ID)){
                            var item = StockItem.Get(old.ItemSKU);
                        <li>
                            <div class="row">
                            <div class="col-9 overflow-hidden">@old.AmountOrdered x @item.NeoSKU @item.Name</div>
                            <div class="col-3 text-end text-nowrap">@(item.Price * old.AmountOrdered) C</div>
                            </div>
                        </li>
                        }
                    </ul>
                        <li>
                            <div class="row">
                            <div class="col-9 text-end">TOTAL</div>
                            <div class="col-3 text-end text-nowrap">@o.GetTotalPrice() C</div>
                            </div>
                        </li>
                </ul>
                <hr class="hr-slash" style="background-color:black" />
            }
        }
    </div>
    <div class="col-1">
    </div>

</div>

<div class="modal" id="deleteCardModal">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Delete Card?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
          <span aria-hidden="true"></span>
        </button>
      </div>
      <div class="modal-body">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger btn-delete-card">Delete</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>