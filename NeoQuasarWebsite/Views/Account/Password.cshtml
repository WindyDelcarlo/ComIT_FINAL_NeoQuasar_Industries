@using NeoQuasarWebsite.DTO
@using NeoQuasarWebsite.Data
@model PasswordViewModel

@{
    ViewData["Title"] = "Editing Account Password";
}

<div class="row">
    <div class="col-6 offset-1" style="font-weight:700">
        <form asp-action="Password" method="post">
            <div class="form-floating">
                <input type="password" class="form-control" asp-for="Password" />
                <label asp-for="Password">Previous Password</label>
            </div><br />
            <div class="form-floating">
                <input type="password" class="form-control" asp-for="NewPassword" />
                <label asp-for="NewPassword">New Password</label>
            </div><br />
            <div class="form-floating">
                <input type="password" class="form-control" asp-for="ConfirmNewPassword" />
                <label asp-for="ConfirmNewPassword">Confirm New Password</label>
            </div><br />
            <button class="btn btn-primary" type="submit">SAVE</button>
        </form>
        
        <hr class="hr-slash" style="background-color:black" />
        <partial name="_PaymentDetails" />
    </div>
    <div class="col-5">
        <partial name="_OrderHistory" />
    </div>
    <div class="col-1">
    </div>
</div>